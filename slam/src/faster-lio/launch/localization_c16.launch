<launch>
<!-- Launch file for c16 LiDAR - Localization Only (No Mapping/Saving) -->

    <arg name="rviz" default="false" />

    <rosparam command="load" file="$(find faster_lio)/config/c16.yaml" />

    <!-- 配置 TF frame id：发布 odom -> base_link -->
    <param name="publish/tf_world_frame" type="string" value="odom" />
    <param name="publish/tf_imu_frame" type="string" value="base_link" />

    <!-- 覆盖配置：关闭建图和保存 -->
    <param name="path_save_en" type="bool" value="false" />
    <param name="pcd_save/pcd_save_en" type="bool" value="false" />
    
    <param name="feature_extract_enable" type="bool" value="false"/>
    <param name="point_filter_num" type="int" value="3"/>
    <param name="max_iteration" type="int" value="3" />
    <param name="filter_size_surf" type="double" value="0.5" />
    <param name="filter_size_map" type="double" value="0.5" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="false" />
    
    <node pkg="faster_lio" type="run_mapping_online" name="laserMapping" output="screen" /> 

    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find faster_lio)/rviz_cfg/loam_livox.rviz" />
    </group>

</launch>
